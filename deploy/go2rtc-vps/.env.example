# Isi di Dokploy → service cctv-gateway → tab Environment. Jangan commit nilai asli.

# IP publik VPS (sama dengan IP_VPS di .env lokal), untuk kandidat WebRTC
PUBLIC_IP=

# Sama dengan RTSP_USER / RTSP_PASS di /etc/go2rtc/go2rtc.env pada PC lokal
RTSP_USER=relay
RTSP_PASS=

# Login API go2rtc VPS (dipakai dashboard untuk signaling & untuk tes via SSH tunnel)
# Buat password acak: openssl rand -hex 16
GO2RTC_API_USER=dashboard
GO2RTC_API_PASS=

# Login kamera, untuk stream bicara (isapi://). Sama dengan CAM_ISAPI_* di dashboard.
CAM_USER=
CAM_PASS=
