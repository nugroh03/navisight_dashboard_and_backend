[Unit]
Description=go2rtc CCTV transcode gateway (local)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=go2rtc
Group=go2rtc
SupplementaryGroups=render video
EnvironmentFile=/etc/go2rtc/go2rtc.env
ExecStart=/usr/local/bin/go2rtc -config /etc/go2rtc/go2rtc.yaml
WorkingDirectory=/var/lib/go2rtc
# Bind ke IP Tailscale gagal bila tailscaled belum siap saat boot; restart sampai berhasil.
Restart=always
RestartSec=5
# Prioritas di bawah Shinobi agar perekaman tidak terganggu.
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/go2rtc

[Install]
WantedBy=multi-user.target
