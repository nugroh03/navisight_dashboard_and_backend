# Salin ke /etc/go2rtc/go2rtc.env (izin 600, milik root) lalu isi.
# Jangan commit file yang sudah diisi.

# Kredensial kamera (sama untuk 8 kamera)
CAM_USER=
CAM_PASS=

# Kredensial RTSP go2rtc lokal (bukan password kamera), dipakai go2rtc VPS untuk mengambil stream.
# Buat password acak: openssl rand -hex 16
RTSP_USER=relay
RTSP_PASS=
