# Alamat API dashboard
MONITOR_URL=https://translautjatim.com/api/monitoring/report
# Token dari scripts/create-monitor-agent.mjs (RAHASIA; file ini harus izin 600)
MONITOR_TOKEN=
# Kamera yang dipantau: IP[=nama], dipisah koma. Nama opsional (dashboard memakai nama kamera bila IP cocok dengan isapiHost)
CAMERAS=192.168.1.34,192.168.1.43,192.168.1.51,192.168.1.102,192.168.1.106,192.168.1.130,192.168.1.141,192.168.1.170
# Router Starlink & target cek internet (TCP)
ROUTER_IP=192.168.1.1
INTERNET_TARGETS=1.1.1.1:443,8.8.8.8:443
INTERVAL_SEC=30
# Rekaman Shinobi (hanya dibaca waktu file-nya): folder video grup + pasangan monitorId=IP kamera.
# Kosongkan untuk mematikan cek rekaman.
SHINOBI_VIDEOS=/video/shinobi/videos/WL3ksOMv0g
RECORDINGS=cSLk5GJCDC=192.168.1.34,IWZbQL1uJm=192.168.1.43,lvWkO76ScO=192.168.1.51,jzPE6pDnUs=192.168.1.102,L1czXsWT8h=192.168.1.106,5IlPRRxheX=192.168.1.130,f960kt4AKJ=192.168.1.141,LQIwuTCf5g=192.168.1.170
# Tanpa file rekaman baru selama ini (menit) = "kamera hidup tapi tidak merekam"
RECORDING_STALE_MIN=12
